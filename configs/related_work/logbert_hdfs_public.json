{
  "simulation_name": "logbert_hdfs_public_repo",
  "home_dir": "./external/logbert_home",
  "input_subdir": ".dataset/hdfs",
  "output_dir": "./results_related/logbert_hdfs_public/output/hdfs",
  "log_file": "HDFS.log",
  "log_format": "<Date> <Time> <Pid> <Level> <Component>: <Content>",
  "parser_type": "drain",
  "train_size": 4855,
  "seed": 1234,
  "force_cpu": true,
  "options": {
    "window_size": 128,
    "adaptive_window": true,
    "seq_len": 512,
    "max_len": 512,
    "min_len": 10,
    "mask_ratio": 0.65,
    "train_ratio": 1,
    "valid_ratio": 0.1,
    "test_ratio": 1,
    "is_logkey": true,
    "is_time": false,
    "hypersphere_loss": true,
    "hypersphere_loss_test": false,
    "scale": null,
    "hidden": 256,
    "layers": 4,
    "attn_heads": 4,
    "epochs": 200,
    "n_epochs_stop": 10,
    "batch_size": 32,
    "corpus_lines": null,
    "on_memory": true,
    "num_workers": 5,
    "lr": 0.001,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_weight_decay": 0.0,
    "with_cuda": false,
    "cuda_devices": null,
    "log_freq": null,
    "num_candidates": 6,
    "gaussian_mean": 0,
    "gaussian_std": 1
  }
}
